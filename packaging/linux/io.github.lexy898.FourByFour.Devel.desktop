[Desktop Entry]
# Gives the windows of debug builds (`just run`, app id io.github.lexy898.FourByFour.Devel) the
# installed icon: KDE and GNOME find a window's icon through the desktop file named after its app
# id. Hidden from menus and search and never a handler; its command runs the installed 4x4 under
# the development id, which hands over to a running debug build.
Type=Application
Name=4x4 Remote (debug build)
Comment=A development run of 4x4 from its source checkout
Exec=env X4_DEVEL=1 4x4 %U
TryExec=4x4
Icon=io.github.lexy898.FourByFour
Terminal=false
NoDisplay=true
StartupWMClass=io.github.lexy898.FourByFour.Devel
SingleMainWindow=true
