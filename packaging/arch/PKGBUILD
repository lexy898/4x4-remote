# Maintainer: lexy898
#
# 4x4 Remote from the commit at the tip of GitHub's master branch: the file the AUR has as
# 4x4-remote-git. In a checkout of the repository, `just package` builds the checkout's own master
# branch with a copy of this file whose source names the checkout.

pkgname=4x4-remote-git
# makepkg replaces this with what pkgver() prints, in the copy of this file that it runs.
pkgver=1.0.0.r0.g0000000
pkgrel=1
pkgdesc='Native desktop client for a remote Transmission daemon'
arch=('x86_64')
url='https://github.com/lexy898/4x4-remote'
license=('MIT OR Apache-2.0')
# geoip-database holds the country files in /usr/share/GeoIP that the Peers tab reads for its flags.
# It is a dependency, not an optional one: 4x4 works without it, but pacman -Rs of the package that
# first brought it in (deluge) would remove an optional one, and the flags would go silently.
# libglvnd, vulkan-icd-loader and wayland are loaded while 4x4 runs, so the binary does not name
# them: libglvnd's libEGL draws through OpenGL when there is no Vulkan driver.
depends=(
  glibc
  libgcc
  geoip-database
  hicolor-icon-theme
  libglvnd
  libxcb
  libxkbcommon
  libxkbcommon-x11
  vulkan-icd-loader
  wayland
)
makedepends=(cargo git fontconfig freetype2)
optdepends=(
  'vulkan-driver: draw through Vulkan; without one 4x4 falls back to OpenGL and uses more memory'
  'xdg-desktop-portal-impl: the file dialog for .torrent files'
)
provides=("4x4-remote=$pkgver")
# 4x4-git is the name this package had before 1.0; pacman offers to remove it.
conflicts=(4x4-remote 4x4-git)
# !lto: makepkg's -flto would reach the C shim wayland-backend compiles, and rust-lld cannot link
# GCC's LTO objects; Cargo's own LTO ([profile.release]) still applies. !debug: the release
# profile strips the binary, so a -debug package would be empty.
options=(!lto !debug)
# `just package` finds this exact source in its copy and names the checkout instead.
source=("4x4-remote::git+https://github.com/lexy898/4x4-remote.git#branch=master")
b2sums=('SKIP')

# The workspace version, then the number of commits and the commit: 1.0.0.r320.g1a2b3c4. The
# count only grows while master is never rewritten, so every new build is an upgrade for pacman.
pkgver() {
  cd 4x4-remote
  local version
  version=$(sed -n '/^\[workspace.package\]/,/^\[/s/^version = "\(.*\)"$/\1/p' Cargo.toml)
  if [[ -z $version ]]; then
    echo "no version in [workspace.package] of Cargo.toml" >&2
    return 1
  fi
  printf '%s.r%s.g%s' "$version" "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
}

prepare() {
  cd 4x4-remote
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target host-tuple
}

build() {
  cd 4x4-remote
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  # The panic locations in the binary would otherwise hold the build dir and the path of cargo's
  # registry in the builder's home.
  export RUSTFLAGS+=" --remap-path-prefix=$srcdir=/build --remap-path-prefix=${CARGO_HOME:-$HOME/.cargo}/registry/src=/cargo"
  # Only the app: the `synthetic` feature and its x4-synthetic demo stay out.
  cargo build --frozen --release -p x4-app --bin 4x4
}

package() {
  cd 4x4-remote
  install -Dm755 target/release/4x4 "$pkgdir/usr/bin/4x4"
  # The .Devel file only lends the icon to the windows of debug builds (`just run`); it is hidden.
  install -Dm644 packaging/linux/io.github.lexy898.FourByFour.desktop \
    packaging/linux/io.github.lexy898.FourByFour.Devel.desktop -t "$pkgdir/usr/share/applications/"
  install -Dm644 packaging/linux/io.github.lexy898.FourByFour.svg -t "$pkgdir/usr/share/icons/hicolor/scalable/apps/"
  install -Dm644 LICENSE-MIT LICENSE-APACHE -t "$pkgdir/usr/share/licenses/$pkgname/"
  # The notice of the flags embedded in the binary (country-flag-icons, MIT).
  install -Dm644 crates/x4-app/assets/flags/LICENSE \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE-country-flag-icons"
}
